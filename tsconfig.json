/*
  ================================================================
  TypeScript Configuration (`tsconfig.json`)
  ================================================================

  Author: Dipen Chavan (hexdee606)
  Version: 0.0.3
  Last Modified: 2025-03-14
  Description: This configuration file sets up TypeScript compiler options,
               module resolution, and alias paths for the project.

  Notes:
    - The 'target' is set to 'ESNext' to compile to the latest ECMAScript version.
    - We use 'node' for module resolution, suitable for Node.js projects.
    - The alias '@test' is mapped to 'utilities/test.ts'.
    - Strict type checking is enabled to ensure better code quality.
    - JavaScript files are allowed in the project for compatibility.

  ================================================================
*/

{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "types": [
      "node"
    ],
    "allowJs": true,
    "outDir": "./dist",
    "paths": {
      "@ConfigSettings": [
        "./settings/ConfigSettings.ts"
      ],
      "@envConf": [
        "./configs/envConf.ts"
      ],
      "@ApiHelper": [
        "./utilities/ApiHelper.ts"
      ],
      "@GraphQLHelper": [
        "./utilities/GraphQLHelper.ts"
      ],
      "@BrowserStorageManager": [
        "./utilities/BrowserStorageManager.ts"
      ],
      "@FileOperationsHelper": [
        "./utilities/FileOperationsHelper.ts"
      ],
      "@PlaywrightActions": [
        "./utilities/PlaywrightActions.ts"
      ],
      "@TestFixtures": [
        "./utilities/TestFixtures.ts"
      ],
      "@PlaywrightMockingAddon": [
        "./utilities/PlaywrightMockingAddon.ts"
      ],
      "@SecureDiagnostics": [
        "./utilities/SecureDiagnostics.ts"
      ],
      "@MemoryKnowledgeBase": [
        "./utilities/MemoryKnowledgeBase.ts"
      ]
    }
  },
  "include": [
    "settings/**/*",
    "configs/**/*",
    "src/**/*",
    "utilities/**/*",
    "playwright.config.ts",
    "node_modules/@types/node/globals.d.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "typeAcquisition": {
    "enable": false
  }
}
