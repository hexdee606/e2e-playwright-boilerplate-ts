# ============================================================
# Playwright E2E Environment Configuration
# ============================================================

# Test environment
# Available: int
# Add more environments in configs/envConf.ts as needed.
E2E=int


# ============================================================
# Environment URL Overrides
# Leave empty to use the URLs configured in envConf.ts
# ============================================================

# Frontend application URL
E2E_FRONTEND_URL=

# REST API URL
E2E_API_URL=

# GraphQL API URL
E2E_GQL_URL=


# ============================================================
# Diagnostics
# ============================================================

# Enable verbose diagnostic logging
E2E_VERBOSE=false

# Allow capturing artifacts that may contain sensitive data
# Keep false unless explicitly required.
E2E_CAPTURE_SENSITIVE_ARTIFACTS=false


# ============================================================
# Browser / Security
# ============================================================

# Allow unsafe Chromium launch flags
# Keep false unless explicitly required for local testing.
E2E_ALLOW_UNSAFE_CHROMIUM=false